          "image": "images/casco.webp",
          "label": "yellow hard hat",
          "correct": false
        },
        {
          "image": "images/pasaporte.webp",
          "label": "passport",
          "correct": false
        }
      ],
      "note": {
        "en": "Necesito means I need. Spanish usually drops yo (I), because the ending -o already shows I.",
        "es": "Necesito significa \"I need\". Casi siempre se omite yo, porque la terminación -o ya indica la primera persona."
      }
    },

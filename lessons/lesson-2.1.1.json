          "label": "car",
          "correct": false
        },
        {
          "image": "images/mesa.webp",
          "label": "table",
          "correct": false
        },
        {
          "image": "images/llave.webp",
          "label": "key",
          "correct": true
        },
        {
          "image": "images/maleta.webp",
          "label": "red suitcase",
          "correct": false
        }
      ],
      "note": {
        "en": "For -ar verbs, the ending -a shows he or she: el cliente necesita. The ending -o shows I: necesito.",
        "es": "En los verbos en -ar, la terminación -a indica él o ella: el cliente necesita. La terminación -o indica yo: necesito."
      }
    },
    {

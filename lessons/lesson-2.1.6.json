    {
      "exerciseId": "2.1.6.1",
      "type": "listen_choose",
      "text": "Abro la puerta.",
      "meaningEn": "I open the door.",
      "choices": [
        {
          "image": "images/llave.webp",
          "label": "key",
          "correct": false
        },
        {
          "image": "images/puerta-abierta.webp",
          "label": "a wide open door",
          "correct": true
        },
        {
          "image": "images/mesa.webp",
          "label": "table",
          "correct": false
        },
        {
          "image": "images/silla.webp",
          "label": "chair",
          "correct": false
        }
      ],
      "note": {
        "en": "Abrir means to open. Abro means I open. Abre means he or she opens. Abrir ends in -ir, so the he or she form ends in -e, not -a.",
        "es": "Abrir significa \"to open\". Abro es yo; abre es él o ella. Abrir termina en -ir, por eso la forma de él o ella termina en -e, no en -a."
      }
    },
    {
      "exerciseId": "2.1.6.2",
      "type": "listen_choose",
      "text": "Cierro la puerta.",
      "meaningEn": "I close the door.",
      "choices": [
        {
          "image": "images/casco.webp",
          "label": "hard hat",
          "correct": false
        },
        {
          "image": "images/martillo.webp",
          "label": "hammer",
          "correct": false
        },
        {
          "image": "images/puerta-abierta.webp",
          "label": "a wide open door",
          "correct": false
        },
        {
          "image": "images/puerta-cerrada.webp",
          "label": "a fully closed door",
          "correct": true
        }
      ],
      "voice": "es-MX-JorgeNeural",
      "note": {
        "en": "Cerrar means to close. In cierro and cierra, the e of cerrar changes to ie. This is a stem change.",
        "es": "Cerrar significa \"to close\". En cierro y cierra, la e de cerrar cambia a ie. Es un cambio de raíz."
      }
    },

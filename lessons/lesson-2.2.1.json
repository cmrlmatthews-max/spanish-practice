    {
      "exerciseId": "2.2.1.1",
      "type": "listen_choose",
      "text": "Subo la escalera.",
      "meaningEn": "I go up the stairs.",
      "choices": [
        {
          "image": "images/subir.webp",
          "label": "stairs going up",
          "correct": true
        },
        {
          "image": "images/llave.webp",
          "label": "key",
          "correct": false
        },
        {
          "image": "images/mapa.webp",
          "label": "map",
          "correct": false
        },
        {
          "image": "images/avion.webp",
          "label": "airplane",
          "correct": false
        }
      ],
      "note": {
        "en": "Subir means to go up. Subo means I go up. The ending -o shows I, as in necesito.",
        "es": "Subir significa \"to go up\". Subo es yo. La terminación -o indica yo, igual que en necesito."
      }
    },
    {
      "exerciseId": "2.2.1.2",
      "type": "listen_choose",
      "text": "Bajo la escalera.",
      "meaningEn": "I go down the stairs.",
      "choices": [
        {
          "image": "images/martillo.webp",
          "label": "hammer",
          "correct": false
        },
        {
          "image": "images/bajar.webp",
          "label": "stairs going down",
          "correct": true
        },
        {
          "image": "images/mesa.webp",
          "label": "table",
          "correct": false
        },
        {
          "image": "images/carro.webp",
          "label": "car",
          "correct": false
        }
      ],
      "voice": "es-MX-JorgeNeural",
      "note": {
        "en": "Bajar means to go down. Bajo means I go down. In other sentences, bajo can also mean low or under.",
        "es": "Bajar significa \"to go down\". Bajo es yo. En otras frases, bajo también puede significar \"low\" o \"under\"."
      }
    },
    {

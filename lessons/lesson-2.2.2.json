          "image": "images/hotel.webp",
          "label": "hotel",
          "correct": false
        },
        {
          "image": "images/martillo.webp",
          "label": "hammer",
          "correct": false
        }
      ],
      "voice": "es-MX-JorgeNeural",
      "note": {
        "en": "Quiere means he or she wants. Querer is irregular: the stem changes. The form is quiere, not quere.",
        "es": "Quiere significa \"he/she wants\". Querer es irregular: cambia la raíz. La forma es quiere, no quere."
      }
    },
    {

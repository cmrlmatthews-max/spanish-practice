      "text": "Hablo con el cliente.",
      "meaningEn": "I talk with the client.",
      "choices": [
        {
          "image": "images/cliente.webp",
          "label": "client",
          "correct": true
        },
        {
          "image": "images/llave.webp",
          "label": "key",
          "correct": false
        },
        {
          "image": "images/silla.webp",
          "label": "chair",
          "correct": false
        },
        {
          "image": "images/martillo.webp",
          "label": "hammer",
          "correct": false
        }
      ],
      "note": {
        "en": "Hablar means to speak or to talk. Hablo means I speak. The ending -o shows I.",
        "es": "Hablar significa \"to speak\" o \"to talk\". Hablo es yo. La terminación -o indica yo."
      }
    },
    {

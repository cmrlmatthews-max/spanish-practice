    {
      "exerciseId": "2.2.2.3",
      "type": "listen_choose",
      "text": "Tengo una idea.",
      "meaningEn": "I have an idea.",
      "choices": [
        {
          "image": "images/llave.webp",
          "label": "key",
          "correct": false
        },
        {
          "image": "images/mesa.webp",
          "label": "table",
          "correct": false
        },
        {
          "image": "images/idea.webp",
          "label": "light bulb",
          "correct": true
        },
        {
          "image": "images/maleta.webp",
          "label": "red suitcase",
          "correct": false
        }
      ],
      "note": {
        "en": "Idea ends in -a and is feminine: una idea. Most nouns that end in -a are feminine, but not all. Example: el mapa is masculine.",
        "es": "Idea termina en -a y es femenino: una idea. La mayoría de los sustantivos en -a son femeninos, pero no todos. Ejemplo: el mapa es masculino."
      }
    },
    {
      "exerciseId": "2.2.2.4",
      "type": "repeat",
      "text": "El diseño.",
      "meaningEn": "The design.",
      "glosses": {
        "el": "the (masculine)",
        "diseño": "design"
      },
      "image": "images/plano.webp",
      "voice": "es-MX-JorgeNeural",
      "note": {
        "en": "Diseño means design. The letter ñ sounds like ny in canyon. It is not the same as n.",
        "es": "Diseño significa \"design\". La letra ñ suena como \"ny\" en \"canyon\". No es lo mismo que n."
      }
    },
    {
      "exerciseId": "2.2.2.5",
      "type": "repeat",
      "text": "Explico el diseño.",
      "meaningEn": "I explain the design.",
      "glosses": {
        "explico": "I explain — 1st person of explicar",
        "el": "the (masculine)",
        "diseño": "design"
      },
      "image": "images/plano.webp",
      "note": {
        "en": "Explicar means to explain. Explico means I explain.",
        "es": "Explicar significa \"to explain\". Explico es yo."
      }
    },
    {
      "exerciseId": "2.2.2.6",

    {
      "exerciseId": "2.2.3.6",
      "type": "listen_choose",
      "text": "Como en el restaurante.",
      "meaningEn": "I eat at the restaurant.",
      "choices": [
        {
          "image": "images/carro.webp",
          "label": "car",
          "correct": false
        },
        {
          "image": "images/restaurante.webp",
          "label": "restaurant",
          "correct": true
        },
        {
          "image": "images/ventana.webp",
          "label": "window",
          "correct": false
        },
        {
          "image": "images/maleta.webp",
          "label": "red suitcase",
          "correct": false
        }
      ],
      "voice": "es-MX-JorgeNeural",
      "note": {
        "en": "Como means I eat (from comer). In other sentences, como also means like or as. The sentence shows the meaning.",
        "es": "Como significa \"I eat\" (de comer). En otras frases, como también significa \"like\" o \"as\". La frase muestra el significado."
      }
    },
    {
      "exerciseId": "2.2.3.7",
      "type": "repeat",
      "text": "Quiero un café.",
      "meaningEn": "I want a coffee.",
      "glosses": {
        "quiero": "I want — 1st person of querer (irregular)",
        "un": "a, an (masculine)",
        "café": "coffee"
      },
      "image": "images/cafe.webp",
      "note": {
        "en": "Quiero means I want. Quiere means he or she wants. Querer is irregular: learn both forms.",
        "es": "Quiero significa \"I want\". Quiere significa \"he/she wants\". Querer es irregular: aprende las dos formas."
      }
    },
    {
      "exerciseId": "2.2.3.8",
      "type": "repeat",
      "text": "Pido la cuenta.",
      "meaningEn": "I ask for the bill.",
      "glosses": {
        "pido": "I ask for, I order — 1st person of pedir",
        "la": "the (feminine)",
        "cuenta": "bill, check"
      },
      "image": "images/cuenta.webp",
      "voice": "es-MX-JorgeNeural",
      "note": {
        "en": "Pedir means to ask for or to order. Preguntar means to ask a question. Do not mix them.",
        "es": "Pedir significa \"to ask for\" o \"to order\". Preguntar significa \"to ask a question\". No se mezclan."
      }
